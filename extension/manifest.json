{
  "manifest_version": 3,
  "name": "Download Manager (DoMa)",
  "version": "1.0.0",
  "description": "Chuyển lượt tải của trình duyệt sang Download Manager (DoMa).",
  "key": "",
  "permissions": [
    "downloads",
    "contextMenus",
    "cookies",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Download Manager (DoMa)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
